<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/new-organization" method="POST">
        <div class="form-group">
            <label for="name">Organization Name</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= locals.name || '' %>"
                maxlength="100"
                required
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="500"
                required
            ><%= locals.description || '' %></textarea>
        </div>

        <div class="form-group">
            <label for="contact_email">Contact Email</label>
            <input
                type="email"
                id="contact_email"
                name="contact_email"
                value="<%= locals.contact_email || '' %>"
                required
            />
        </div>

        <button type="submit">Add Organization</button>
    </form>
</main>
<%- include('partials/footer') %>