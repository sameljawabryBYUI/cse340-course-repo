<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/new-project" method="POST">
        <div class="form-group">
            <label for="title">Project Title</label>
            <input type="text" id="title" name="title" value="<%= locals.projTitle || '' %>" maxlength="100" required>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" required><%= locals.description || '' %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= locals.location || '' %>" required>
        </div>

        <div class="form-group">
            <label for="date">Project Date</label>
            <input type="date" id="date" name="date" value="<%= locals.date || '' %>" required>
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">Select an Organization</option>
                <% organizations.forEach(org => { %>
                    <option value="<%= org.organization_id %>" <%= locals.organizationId == org.organization_id ? 'selected' : '' %>>
                        <%= org.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <button type="submit">Add Project</button>
    </form>
</main>
<%- include('partials/footer') %>