<%- include('partials/header') %>
<h1><%= title %></h1>
<p>Here are our partner organizations.</p>

<p><a href="/new-organization"><strong>+ Add New Organization</strong></a></p>

<% organizations.forEach(org => { %>
    <div class="organization" style="margin-bottom: 30px;">
        <h2><a href="/organization/<%= org.organization_id %>"><%= org.name %></a></h2>
        <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo" style="max-width: 400px; border-radius: 8px;">
        <p><%= org.description %></p>
        <p><small>Contact: <%= org.contact_email %></small></p>
    </div>
<% }) %>

<%- include('partials/footer') %>