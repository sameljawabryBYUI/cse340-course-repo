<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <div class="project-details">
        <h2><%= projectDetails.title %></h2>
        <p><strong>Date:</strong> <%= new Date(projectDetails.project_date).toLocaleDateString() %></p>
        <p><strong>Location:</strong> <%= projectDetails.location %></p>
        <p><strong>Description:</strong> <%= projectDetails.description %></p>
        
        <p>
            <strong>Organization:</strong> 
            <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a>
        </p>

        <!-- NEW: Volunteering Section -->
        <% if (user) { %>
            <div style="background-color: #f9f9f9; padding: 15px; border-radius: 5px; margin: 20px 0; border: 1px solid #ddd;">
                <h3 style="margin-top: 0;">Volunteer Status</h3>
                <% if (isVolunteering) { %>
                    <p style="color: green; font-weight: bold;">✅ You are volunteering for this project!</p>
                    <p><a href="/project/<%= projectDetails.project_id %>/unvolunteer" style="color: #dc3545; text-decoration: underline;">Remove me as a volunteer</a></p>
                <% } else { %>
                    <p><a href="/project/<%= projectDetails.project_id %>/volunteer" style="display: inline-block; padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;">Volunteer for this Project</a></p>
                <% } %>
            </div>
        <% } %>

        <h3>Categories</h3>
        <% if (user && user.role_name === 'admin') { %>
            <p><a href="/project/<%= projectDetails.project_id %>/assign-categories"><strong>+ Assign/Update Categories</strong></a></p>
        <% } %>
        
        <div class="category-tags">
            <% if (categories && categories.length > 0) { %>
                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>" style="display: inline-block; padding: 4px 8px; margin-right: 5px; background-color: #e0e0e0; border-radius: 4px; text-decoration: none; color: #333;">
                        <%= category.category_name %>
                    </a>
                <% }) %>
            <% } else { %>
                <p>No categories assigned.</p>
            <% } %>
        </div>
        
        <br>
        <% if (user && user.role_name === 'admin') { %>
            <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project Details</a></p>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>