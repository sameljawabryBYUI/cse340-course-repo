<%- include('partials/header') %>
<h1><%= title %></h1>
<p>View our upcoming service projects.</p>

<ul>
    <% projects.forEach(project => { %>
        <li>
            <strong><a href="/project/<%= project.project_id %>"><%= project.title %></a></strong> — 
            <em><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></em><br>
            <%= project.description %><br>
            Location: <%= project.location %> | Date: <%= project.project_date.toISOString().split('T')[0] %>
        </li>
        <br>
    <% }) %>
</ul>

<%- include('partials/footer') %>